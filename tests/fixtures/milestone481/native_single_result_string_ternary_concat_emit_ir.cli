declare i32 @printf(ptr, ...)

@.fmt_int = private unnamed_addr constant [5 x i8] c"%lld\00"
@.fmt_float = private unnamed_addr constant [3 x i8] c"%g\00"
@.fmt_str = private unnamed_addr constant [3 x i8] c"%s\00"
@.str.0 = private unnamed_addr constant [6 x i8] c"hello\00"
@.str.1 = private unnamed_addr constant [2 x i8] c"\0A\00"
@.str.2 = private unnamed_addr constant [8 x i8] c"say yes\00"

define i32 @main() {
entry:
  %tmp0 = add i64 1, 2
  %tmp1 = icmp eq i64 %tmp0, 3
  call i32 (ptr, ...) @printf(ptr @.fmt_str, ptr @.str.0)
  call i32 (ptr, ...) @printf(ptr @.fmt_str, ptr @.str.1)
  call i32 (ptr, ...) @printf(ptr @.fmt_str, ptr @.str.2)
  ret i32 0
}
